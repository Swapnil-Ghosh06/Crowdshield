# =============================================================================
# CrowdShield — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your keys. Never commit real keys.

# --- Pipeline Server Configuration ---
MOCK_MODE=true
VIDEO_PATH=sample.mp4
BROADCAST_INTERVAL=3

# --- Vision Engine Configuration ---
ZONE_AREA_SQM=50.0
VISION_SAMPLE_INTERVAL=3.0
DETECTOR_BACKEND=hog

# --- 4-Layer LLM Cascade & Recommendation Engine ---
LLM_CASCADE_ENABLED=true
RECOMMENDATIONS_USE_LLM=true

# Layer 1 (Primary) — Google Gemini API
# Free Tier: 15 RPM / 1M TPM / 1,500 RPD
GEMINI_API_KEY=your_gemini_key_here

# Layer 2 (Secondary Fallback) — Groq Cloud API
# Free Tier: 30 RPM / 14,400 RPD
GROQ_API_KEY=your_groq_key_here

# Layer 3 (Tertiary Fallback) — Cohere API
# Free Trial Key: 1,000 monthly API calls
COHERE_API_KEY=your_cohere_key_here

# Layer 4 (Quaternary Guaranteed Fallback) — Rule-based Templates
# Deterministic, zero-network, zero-API fallback that never fails.
